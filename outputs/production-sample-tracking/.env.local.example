NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Keep this key server-side only. Do not expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-side security controls.
SESSION_SECRET=generate-a-long-random-secret
CRON_SECRET=generate-a-long-random-cron-secret

# Optional. Send monitor failures to Slack/Discord/Make/Zapier webhook.
ALERT_WEBHOOK_URL=

# Private Vercel Blob store used as an off-platform backup copy.
BLOB_READ_WRITE_TOKEN=

# Optional monitor thresholds.
BACKUP_MAX_AGE_HOURS=24
MONITOR_FAILURE_THRESHOLD=5

# Optional local controlled-write test login verification.
CONTROLLED_TEST_USERNAME=jack
CONTROLLED_TEST_PASSWORD=
